# ═══════════════════════════════════════════════════════════════════════════════
# 🐝 BONIFADE TECHNOLOGIES — BUZZ COMPANY SWARM ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# This file contains the complete, annotated list of environment variables used
# by the Buzz Swarm stack (Relay, Postgres, Redis, AI Brain, Bridges & R2).
#
# INSTRUCTIONS:
# 1. To install automatically, simply run: ./install.sh
# 2. To configure manually, copy this file: cp .env.example .env
# 3. Fill in the values below. NEVER commit your live .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1. GENERAL DEPLOYMENT & NETWORKING
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
COMPANY_NAME="Bonifade Technologies"
COMPANY_WEBSITE="https://bonifadetechnologies.com"

# Hostname or VPS IP (e.g. buzz.bonifadetechnologies.com or 167.99.123.45)
DOMAIN_NAME=localhost
HTTP_SCHEME=http

# Public ports exposed on the VPS host
APP_PORT=4005
RELAY_PORT=4005
ADMIN_PORT=8081
HEALTH_PORT=9090
METRICS_PORT=9091

# Full public access URLs
PUBLIC_URL=http://localhost:4005
RELAY_PUBLIC_URL=ws://localhost:4005

# ─────────────────────────────────────────────────────────────────────────────
# 1b. BONIFADE INFRA SWARM OVERLAY (~/Documents/infra → network "infrastructure")
# ─────────────────────────────────────────────────────────────────────────────
# Your shared VPS stack (Docker Swarm) exposes DNS aliases on an attachable
# overlay named "infrastructure":
#   • pgbouncer   → Postgres pooler (apps use port 6432 inside the overlay)
#   • postgres    → Postgres direct  (port 5432 — admin/migrations)
#   • redis-proxy → Redis via HAProxy (port 6379)
#
# Wire Buzz to that overlay (no VPS IP needed):
USE_INFRA_OVERLAY=false
INFRA_OVERLAY_NETWORK=infrastructure

# When true, ./manage.sh also loads docker-compose.infra.yml so relay +
# agent-orchestrator join the overlay and can resolve pgbouncer / redis-proxy.

# ─────────────────────────────────────────────────────────────────────────────
# 2. DATABASE (POSTGRESQL — LOCAL COMPOSE OR BONIFADE INFRA / CLOUD)
# ─────────────────────────────────────────────────────────────────────────────
# false = start local buzz-postgres on buzz-network
# true  = skip local postgres; use DATABASE_URL hostname
USE_EXTERNAL_POSTGRES=false

# Option A: Local Docker Postgres (default — service name "postgres" on buzz-network)
POSTGRES_USER=buzz
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=buzz
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://buzz:${POSTGRES_PASSWORD}@postgres:5432/buzz

# Option B: Bonifade infra stack on same VPS (recommended for production)
# Prerequisites: infra stack deployed; DB created on overlay, e.g.
#   docker run --rm --network infrastructure postgres:17-alpine \
#     psql -h postgres -U postgres -c "CREATE DATABASE buzz;"
# Then set (use the SAME passwords as ~/Documents/infra/.env):
# USE_EXTERNAL_POSTGRES=true
# USE_INFRA_OVERLAY=true
# INFRA_OVERLAY_NETWORK=infrastructure
# DATABASE_URL=postgres://postgres:YOUR_INFRA_POSTGRES_PASSWORD@pgbouncer:6432/buzz
# (prefer pgbouncer:6432 for apps; use @postgres:5432 only for admin/migrations)

# Option C: External Cloud Postgres:
# • Supabase:     DATABASE_URL=postgres://postgres.xyz:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# • Neon.tech:    DATABASE_URL=postgres://user:[PASSWORD]@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# • AWS RDS:      DATABASE_URL=postgres://buzz:[PASSWORD]@your-rds-cluster.us-east-1.rds.amazonaws.com:5432/buzz?sslmode=require
# • DigitalOcean: DATABASE_URL=postgres://doadmin:[PASSWORD]@db-postgresql-nyc1-xyz.ondigitalocean.com:25060/defaultdb?sslmode=require
DB_POOL_SIZE=25

# ─────────────────────────────────────────────────────────────────────────────
# 3. CACHE & PUBSUB (REDIS — LOCAL COMPOSE OR BONIFADE INFRA)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379

# Option A: Local compose Redis (not published to host — no clash with infra Redis)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Option B: Bonifade infra Redis on overlay "infrastructure"
# (skips local buzz-redis when host is not "redis"/localhost):
# USE_INFRA_OVERLAY=true
# REDIS_URL=redis://:YOUR_INFRA_REDIS_PASSWORD@redis-proxy:6379/0
# Optional DB indexes (infra convention): /0 cache, /1 sessions, /2 queues
REDIS_POOL_SIZE=16

# ─────────────────────────────────────────────────────────────────────────────
# 4. BUZZ RELAY CONFIGURATION (BLOCK BUZZ ENGINE)
# ─────────────────────────────────────────────────────────────────────────────
BUZZ_BIND_ADDR=0.0.0.0:8080
BUZZ_RELAY_URL=ws://relay:8080

# 64-character hex secp256k1 private key for the relay (auto-generated by install.sh)
BUZZ_RELAY_PRIVATE_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
# Corresponding 64-character hex public key of the relay owner
BUZZ_RELAY_OWNER_PUBKEY=

# Internal HMAC secret for Git hooks and internal webhook calls
BUZZ_GIT_HOOK_HMAC_SECRET=your_64_hex_hmac_secret_here

# Access control flags (set to true if you want invite/token-only closed workspace)
BUZZ_REQUIRE_AUTH_TOKEN=false
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false
BUZZ_AUDIT_ENABLED=true
BUZZ_HUDDLE_AUDIO_AVAILABLE=true
CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────────────
# 5. AI NEURAL PROVIDERS (SWARM BRAIN)
# ─────────────────────────────────────────────────────────────────────────────
# PRIMARY Provider: Google Gemini (Recommended — Ultra-fast, hybrid reasoning, coding & agentic)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyExampleKeyHere
# Primary operational model (Dev, QA, Growth, Content, Support, Billing, DevOps):
DEFAULT_GEMINI_MODEL=gemini-3.5-flash
# Flagship advanced reasoning model (CEO Fade_networker, CTO, Legal Officer, Market Research):
PRO_GEMINI_MODEL=gemini-3.7-flash

# Multi-Provider Fallback Cascade (If Gemini is busy or down, swarm automatically cascades):
# 1. Anthropic Claude (Direct Claude 3.7 / 3.5 Sonnet) -> https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-exampleKeyHere

# 2. OpenAI (GPT-5.3, GPT-5, o3-mini, GPT-4.5) -> https://platform.openai.com
OPENAI_API_KEY=sk-proj-exampleKeyHere

# 3. xAI Grok (Grok-2) -> https://console.x.ai
XAI_API_KEY=xai-exampleKeyHere

# 4. DeepSeek (DeepSeek-V3 / R1) -> https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-exampleDeepseekKeyHere

# 5. MiniMax (MiniMax-01 / Abab 6.5s) -> https://api.minimax.chat
MINIMAX_API_KEY=

# 6. Zhipu GLM (GLM-4-Plus) -> https://open.bigmodel.cn
GLM_API_KEY=

# 7. Meta Muse Spark (Meta Model API) -> https://dev.meta.ai / https://ai.developer.meta.com
# Get a Model API key at: https://dev.meta.ai
# Contributor tier (discounted; prompts/completions may train Meta models):
META_AI_API_KEY=
META_AI_ENDPOINT=https://api.meta.ai/v1/chat/completions
META_AI_MODEL=muse-spark-1.2-contributor
# Standard paid tier (no training on your data) — orchestrator falls back automatically:
# META_AI_MODEL=muse-spark-1.2

# 8. OpenRouter Universal Gateway (Claude, Grok, MiniMax, GLM, Muse Spark, GPT) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-exampleKeyHere

# Moonshot AI (Kimi) Key (Specialized long-context document research)
MOONSHOT_API_KEY=

# Active default provider and model used by the multi-agent orchestrator
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-3.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# 6. WEB SCRAPING & MARKET INTELLIGENCE (@marketer-research)
# ─────────────────────────────────────────────────────────────────────────────
# Powers Firecrawl deep web search, scraping, and lead extraction
# Get a key at: https://firecrawl.dev
FIRECRAWL_API_KEY=fc-exampleKeyHere

# Agent tools (PDF export, Firecrawl, …). PDFs land in ./data/exports/
ENABLE_AGENT_TOOLS=true
MAX_TOOL_ROUNDS=5
DATA_DIR=/app/data
# Company logo used on generated PDFs (icon preferred for headers)
COMPANY_LOGO_PATH=/app/assets/brand/logo-icon.jpeg

# ─────────────────────────────────────────────────────────────────────────────
# 7. AI VIDEO GENERATION (@marketer-growth)
# ─────────────────────────────────────────────────────────────────────────────
# HeyGen: AI presenter / avatar demo videos, personalized outreach & translations
# Get a key at: https://app.heygen.com/settings?from=header (API Access)
HEYGEN_API_KEY=

# Google Veo 3.1 (via Gemini API): Native video generation for ads & b-roll
VEO_MODEL=veo-3.1-generate-preview
VEO_FAST_MODEL=veo-3.1-fast-generate-preview

# ─────────────────────────────────────────────────────────────────────────────
# 8. UI & DESIGN GENERATION (Stitch MCP)
# ─────────────────────────────────────────────────────────────────────────────
# Google Stitch — AI UI mockup and banner designer used by the CTO & Designer
# Get a key at: https://stitch.withgoogle.com -> Settings -> API Key
STITCH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 9. TELEGRAM MESSAGING BRIDGE
# ─────────────────────────────────────────────────────────────────────────────
# Create a Telegram Bot via @BotFather on Telegram (run /newbot)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram group chat ID for company-wide notifications & lead alerts:
# (Add bot to group as admin, send a test msg, visit https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# Direct Telegram chat ID of the CEO (for escalations & executive briefing):
CEO_TELEGRAM_CHAT_ID=123456789

# ─────────────────────────────────────────────────────────────────────────────
# 10. WHATSAPP MESSAGING BRIDGE (Meta WhatsApp Cloud API)
# ─────────────────────────────────────────────────────────────────────────────
# Meta for Developers (https://developers.facebook.com -> WhatsApp -> API Setup)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=EAAG...exampleTokenHere
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here
WHATSAPP_GROUP_ID=120363000000000000@g.us

# ─────────────────────────────────────────────────────────────────────────────
# 11. SMTP & IMAP EMAIL BRIDGE (Gmail or Custom Mail Server)
# ─────────────────────────────────────────────────────────────────────────────
# Outbound transactional email (Proposals, Invoices, Client Replies)
# For Gmail, enable 2FA and generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bonifadetechnologies@gmail.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM_EMAIL=bonifadetechnologies@gmail.com
SMTP_FROM_NAME="Bonifade Technologies Swarm"

# Anti-spam rate limits (protects sender domain reputation)
EMAIL_DAILY_LIMIT=500
EMAIL_HOURLY_LIMIT=200
EMAIL_SEND_INTERVAL_SECONDS=20

# Inbound email polling (Reads incoming emails and notifies Telegram/Buzz #support)
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=bonifadetechnologies@gmail.com
IMAP_PASSWORD=abcd efgh ijkl mnop

# ─────────────────────────────────────────────────────────────────────────────
# 12. EXECUTIVE CONTACTS & BANK DETAILS
# ─────────────────────────────────────────────────────────────────────────────
CEO_NAME="Fade_networker"
CEO_EMAIL=bowofadeoyerinde@gmail.com
CEO_WHATSAPP_NUMBER=+2347081353229
COMPANY_PHONE=+2347065720177
COMPANY_OFFICIAL_EMAIL=bonifadetechnologies@gmail.com

# Official Bank Account for Invoices & Quotations (@billing-officer)
COMPANY_BANK_NAME="Moniepoint MFB"
COMPANY_BANK_ACCOUNT=7065720177
COMPANY_BANK_ACCOUNT_NAME="Bonifade Technologies"

# ─────────────────────────────────────────────────────────────────────────────
# 13. CLOUDFLARE R2 OBJECT STORAGE (Zero-Egress Cloud Storage & Backups)
# ─────────────────────────────────────────────────────────────────────────────
# Create at: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=bonifade-buzz-storage
# Endpoint URL format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com

# ─────────────────────────────────────────────────────────────────────────────
# 14. ADMINISTRATIVE ACCESS, JWT & AUTOMATED SSL
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=bonifadetechnologies@gmail.com
ADMIN_API_TOKEN=your_secure_admin_api_token_here
JWT_SECRET=your_secure_jwt_secret_here
LETSENCRYPT_EMAIL=bonifadetechnologies@gmail.com

# Optional GitHub Token (if using GitHub MCP or repo sync)
GITHUB_TOKEN=ghp_exampleTokenHere

# Optional Browser Automation Key (for browser-use gateway)
BROWSER_USE_API_KEY=
