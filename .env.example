# ═══════════════════════════════════════════════════════════════
# Bonifade Technologies — Buzz Company Swarm Environment Config
# ═══════════════════════════════════════════════════════════════
# This file contains all environment variables required for running
# the Buzz Swarm on a VPS or local server with multi-channel support
# (Web UI, Telegram, WhatsApp, SMTP/Email, and AI Swarm Agents).
#
# DO NOT commit the actual .env file with real secrets to git.
# Run ./install.sh to generate this file interactively.
# ═══════════════════════════════════════════════════════════════

# ── 1. General & VPS Deployment ───────────────────────────────
ENVIRONMENT=production
COMPANY_NAME="Bonifade Technologies"
DOMAIN_NAME=localhost
HTTP_SCHEME=http
# Port exposed on the host (if not using Caddy/Nginx reverse proxy directly)
APP_PORT=4005
RELAY_PORT=4005
ADMIN_PORT=8081
HEALTH_PORT=9090
METRICS_PORT=9091

# Public URL reachable by clients and WebSockets
# Example: https://buzz.bonifadetechnologies.com or http://YOUR_VPS_IP:4005
PUBLIC_URL=http://localhost:4005
RELAY_PUBLIC_URL=ws://localhost:4005

# ── 2. Database (PostgreSQL 17) ───────────────────────────────
POSTGRES_USER=buzz
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=buzz
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://buzz:${POSTGRES_PASSWORD}@postgres:5432/buzz
DB_POOL_SIZE=25

# ── 3. Cache & PubSub (Redis 7) ───────────────────────────────
REDIS_PASSWORD=generate_strong_redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_POOL_SIZE=16

# ── 4. Buzz Relay Configuration ───────────────────────────────
BUZZ_BIND_ADDR=0.0.0.0:8080
BUZZ_RELAY_URL=ws://localhost:8080
# 64-character hex private key for relay event signing (auto-generated by install.sh)
BUZZ_RELAY_PRIVATE_KEY=
# Relay owner secp256k1 public key (hex)
BUZZ_RELAY_OWNER_PUBKEY=
# HMAC secret for internal webhooks and git pre-receive hook verification
BUZZ_GIT_HOOK_HMAC_SECRET=generate_strong_hmac_secret_here
# Authentication & Membership switches
BUZZ_REQUIRE_AUTH_TOKEN=false
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false
BUZZ_AUDIT_ENABLED=true
BUZZ_HUDDLE_AUDIO_AVAILABLE=true
CORS_ORIGINS=*

# ── 5. AI LLM Providers (The Brain of the Swarm) ──────────────
# PRIMARY provider: Google Gemini (High speed, 1M+ context, vision & code reasoning)
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (GPT-4o, GPT-4o-mini, embeddings)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter API Key (Unified fallback provider: Claude, DeepSeek, Mistral, Llama 3)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic Claude API Key (Claude 3.5 Sonnet / Opus)
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Moonshot AI (Kimi) API Key (Deep long-context document research)
MOONSHOT_API_KEY=

# Default active model for the agent orchestrator
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash

# ── 6. Web Research & Scraping (Marketing & Dev Swarm) ─────────
# Powers Firecrawl web search, scrape, and deep research
# Get a key at: https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── 7. Telegram Messaging Bridge ──────────────────────────────
# Bidirectional bridge: Control your company swarm via Telegram
# Create a bot with @BotFather on Telegram -> paste token here:
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# Group chat ID for company alerts and notifications:
# (Add bot to group as admin, send a test msg, check https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_GROUP_CHAT_ID=
# Direct Telegram chat ID of the CEO (for escalations and daily executive briefs):
CEO_TELEGRAM_CHAT_ID=

# ── 8. WhatsApp Messaging Bridge ──────────────────────────────
# WhatsApp Cloud API (Meta for Developers) or QR/Baileys Gateway
WHATSAPP_ENABLED=false
# Meta WhatsApp Cloud API credentials (https://developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate_webhook_verify_token_here
# Optional WhatsApp Group ID (format: 120363...@g.us)
WHATSAPP_GROUP_ID=

# ── 9. SMTP & Email Messaging Bridge ──────────────────────────
# Outbound transactional email (Support, Billing, Client Proposals, Alerts)
# Recommended: Gmail SMTP with App Password, Postmark, SendGrid, or Resend
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bonifadetechnologies@gmail.com
# For Gmail, generate an App Password with 2FA enabled at https://myaccount.google.com/apppasswords
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=bonifadetechnologies@gmail.com
SMTP_FROM_NAME=Bonifade Technologies Swarm

# Anti-Spam Sending Limits (Protects domain & email reputation)
EMAIL_DAILY_LIMIT=500
EMAIL_HOURLY_LIMIT=200
EMAIL_SEND_INTERVAL_SECONDS=20

# Inbound Email Checking (IMAP ticket ingestion into Buzz)
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=bonifadetechnologies@gmail.com
IMAP_PASSWORD=

# ── 10. Executive & Company Contact Information ────────────────
CEO_NAME="Hermes CEO"
CEO_EMAIL=bowofadeoyerinde@gmail.com
CEO_WHATSAPP_NUMBER=+2347081353229
COMPANY_PHONE=+2347065720177
COMPANY_OFFICIAL_EMAIL=bonifadetechnologies@gmail.com
COMPANY_WEBSITE=https://bonifadetechnologies.com
COMPANY_BANK_NAME="Moniepoint MFB"
COMPANY_BANK_ACCOUNT=7065720177
COMPANY_BANK_ACCOUNT_NAME="Bonifade Technologies"

# ── 11. Cloudflare R2 / S3 Object Storage (Media & Backups) ────
# S3-compatible storage for Buzz media uploads, DB snapshots & assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bonifade-buzz-storage
# Format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── 12. Security & Administrative Access ───────────────────────
ADMIN_EMAIL=bonifadetechnologies@gmail.com
ADMIN_API_TOKEN=generate_admin_secret_token_here
JWT_SECRET=generate_strong_jwt_secret_here
LETSENCRYPT_EMAIL=bonifadetechnologies@gmail.com
