FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
RUN pip install --no-cache-dir \
    "websockets>=12.0" \
    "httpx>=0.27.0" \
    "pydantic>=2.7.0" \
    "redis>=5.0.0" \
    "asyncpg>=0.29.0" \
    "google-generativeai>=0.8.0" \
    "openai>=1.30.0" \
    "anthropic>=0.25.0" \
    "cryptography>=42.0.0" \
    "pyyaml>=6.0" \
    "fpdf2>=2.7.0"

COPY . /app

ENV PYTHONPATH=/app/agents:/app
ENV DATA_DIR=/app/data
ENV ENABLE_AGENT_TOOLS=true

CMD ["python3", "-u", "/app/agents/orchestrator.py"]
